package config

import io
import os
import encoding.value
import encoding.encerr
import encoding.yaml

pub struct Site:
    pub title: str = "My Site"
    pub description: str = ""
    pub url: str = ""
    pub language: str = "en"
    pub output: str = "dist"
    pub content_dir: str = "content"
    pub layouts_dir: str = "layouts"
    pub assets_dir: str = "assets"
    pub data_dir: str = "data"
    pub static_dir: str = "static"
    pub pagination_size: int = 10
    pub languages: Vector<str> = Vector {} as Vector<str>
    pub data: value.Value = value.Value {}
end

func str_field(obj: value.Value, key: str, def: str): str:
    mut ok := false
    v := value.ObjectGetOk(obj, key, ok)
    if !ok || !value.IsString(v): ret def end
    ret value.AsString(v)
end

func int_field(obj: value.Value, key: str, def: int): int:
    mut ok := false
    v := value.ObjectGetOk(obj, key, ok)
    if !ok || !value.IsInt(v): ret def end
    ret value.AsInt(v) as int
end

func str_array_field(obj: value.Value, key: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut ok := false
    v := value.ObjectGetOk(obj, key, ok)
    if !ok || !value.IsArray(v): ret out end
    repeat value.ArrayLen(v) with i:
        item := value.ArrayGet(v, i)
        if value.IsString(item): out.push(value.AsString(item)) end
    end
    ret out
end

pub func Load(path: str): Site:
    mut site := Site {}
    mut root := value.NewValueObject()

    if os.Exists(path):
        text := io.ReadFile(path)
        mut err := encerr.NoError()
        decoded := yaml.Decode(text, err)
        if err.kind != encerr.KindNone:
            printerrln "neyx: warning: could not parse", path, "-", err.message
        else:
            if value.IsObject(decoded):
                root = decoded
            end
        end
    end

    site.title = str_field(root, "title", site.title)
    site.description = str_field(root, "description", site.description)
    site.url = str_field(root, "url", site.url)
    site.language = str_field(root, "language", site.language)
    site.output = str_field(root, "output", site.output)
    site.content_dir = str_field(root, "content", site.content_dir)
    site.layouts_dir = str_field(root, "layouts", site.layouts_dir)
    site.assets_dir = str_field(root, "assets", site.assets_dir)
    site.data_dir = str_field(root, "data", site.data_dir)
    site.static_dir = str_field(root, "static", site.static_dir)
    site.pagination_size = int_field(root, "pagination_size", site.pagination_size)
    site.languages = str_array_field(root, "languages")

    value.ObjectSet(root, "title", value.ValueString(site.title))
    value.ObjectSet(root, "description", value.ValueString(site.description))
    value.ObjectSet(root, "url", value.ValueString(site.url))
    value.ObjectSet(root, "language", value.ValueString(site.language))
    site.data = root
    ret site
end
