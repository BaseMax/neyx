package app

import os
import collections
import cli
import newcmd "../scaffold/new.salam"
import buildcmd "../build/builder.salam"
import devcmd "../dev/dev.salam"
import previewcmd "../preview/preview.salam"
import cleancmd "../clean/clean.salam"
import checkcmd "../check/check.salam"
import infocmd "../info/info.salam"
import doctorcmd "../doctor/doctor.salam"
import routescmd "../routes/routes.salam"
import benchmarkcmd "../benchmark/benchmark.salam"
import version "../version/version.salam"

func slice_args(argv: Vector<str>): Vector<str>:
    if argv.len() <= 1: ret Vector {} end
    ret collections.slice(argv, 1, argv.len() - 1)
end

func new_app(): cli.App:
    mut app := cli.New("neyx", "A lightweight, ultra-fast static site generator built with Salam.", version.VERSION)
    cli.Register(app, "new", "Create a new NeyX project")
    cli.Register(app, "init", "Initialize a NeyX project in the current directory")
    cli.Register(app, "dev", "Start the development server")
    cli.Register(app, "build", "Build the site for production")
    cli.Register(app, "preview", "Preview the production build")
    cli.Register(app, "clean", "Remove the output directory")
    cli.Register(app, "check", "Check the build for broken links and missing assets")
    cli.Register(app, "info", "Show project information")
    cli.Register(app, "doctor", "Diagnose common project problems")
    cli.Register(app, "routes", "List computed routes")
    cli.Register(app, "benchmark", "Time repeated builds of this project")
    ret app
end

pub func Run(process_argv: Vector<str>):
    app := new_app()
    argv := slice_args(process_argv)
    cmd := cli.Dispatch(app, argv)
    rest := cli.RemainingArgs(argv)

    if cmd == cli.CmdHelp:
        println cli.Usage(app)
        ret
    end

    if cmd == cli.CmdVersion:
        println "neyx", version.VERSION
        ret
    end

    if cmd == "new":
        newcmd.Run(rest)
        ret
    end

    if cmd == "init":
        newcmd.Init(rest)
        ret
    end

    if cmd == "build":
        buildcmd.Run(rest)
        ret
    end

    if cmd == "dev":
        devcmd.Run(rest)
        ret
    end

    if cmd == "preview":
        previewcmd.Run(rest)
        ret
    end

    if cmd == "clean":
        cleancmd.Run(rest)
        ret
    end

    if cmd == "check":
        checkcmd.Run(rest)
        ret
    end

    if cmd == "info":
        infocmd.Run(rest)
        ret
    end

    if cmd == "doctor":
        doctorcmd.Run(rest)
        ret
    end

    if cmd == "routes":
        routescmd.Run(rest)
        ret
    end

    if cmd == "benchmark":
        benchmarkcmd.Run(rest)
        ret
    end

    printerrln "neyx: unknown command", "'" + argv.get(0) + "'"
    printerrln ""
    println cli.Usage(app)
    os.Exit(1)
end
