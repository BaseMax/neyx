package scaffold

import os
import io
import time
import config "../config/config.salam"
import encoding
import mem
import blk "../markdown/blocks.salam"

extern:
    func fopen(path: str, mode: str): void*
    func fwrite(ptr: void*, size: u64, nmemb: u64, stream: void*): u64
    func fclose(fp: void*): int
end

const CONFIG_TPL := "title: \"My Site\"\ndescription: \"A new NeyX site\"\nurl: \"https://example.com\"\nlanguage: \"en\"\noutput: \"dist\"\n"

const INDEX_TPL := "---\ntitle: \"Home\"\ndescription: \"Welcome to my new NeyX site\"\n---\n\n# Welcome to NeyX\n\nThis is your new site. Edit `content/index.md` to get started.\n"

const LAYOUT_TPL := "<!doctype html>\n<html lang=\"{{ lang }}\" dir=\"{{ dir }}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{ title }} - {{ site.title }}</title>\n{{ if description }}<meta name=\"description\" content=\"{{ description }}\">{{ end }}\n{{ if noindex }}<meta name=\"robots\" content=\"noindex\">{{ end }}\n<link rel=\"canonical\" href=\"{{ site.url }}{{ url }}\">\n<link rel=\"icon\" href=\"/assets/favicon.ico\" sizes=\"any\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/favicon-dark.png\" media=\"(prefers-color-scheme: light)\">\n<link rel=\"icon\" type=\"image/png\" href=\"/assets/favicon-light.png\" media=\"(prefers-color-scheme: dark)\">\n<link rel=\"apple-touch-icon\" href=\"/assets/apple-touch-icon.png\">\n{{ each t in translations }}<link rel=\"alternate\" hreflang=\"{{ t.lang }}\" href=\"{{ site.url }}{{ t.url }}\">{{ end }}\n<meta property=\"og:title\" content=\"{{ title }}\">\n{{ if description }}<meta property=\"og:description\" content=\"{{ description }}\">{{ end }}\n<meta property=\"og:url\" content=\"{{ site.url }}{{ url }}\">\n<meta property=\"og:type\" content=\"website\">\n<meta name=\"twitter:card\" content=\"summary\">\n</head>\n<body>\n<main>\n{{ & content }}\n</main>\n</body>\n</html>\n"

const GITIGNORE_TPL := "/dist\n"

const FAVICON_ICO_B64 := ""

const FAVICON_LIGHT_B64 := ""

const FAVICON_DARK_B64 := ""

const APPLE_TOUCH_ICON_B64 := ""

func join(dir: str, rest: str): str:
    if dir == "": ret rest end
    ret dir + "/" + rest
end

func write_default_favicon(dir: str, name: str, b64: str):
    cap := b64.len() / 4 * 3 + 4
    buf := mem.Allocate(cap as u64)
    mut ok := false
    n := encoding.Base64DecodeBytes(b64, buf, cap, ok)
    if ok:
        fp := fopen(join(dir, "assets/" + name), "wb")
        if fp != null:
            fwrite(buf, 1 as u64, n as u64, fp)
            fclose(fp)
        end
    end
    mem.Free(buf)
end

func scaffold_into(dir: str):
    os.MkdirAll(join(dir, "content"))
    os.MkdirAll(join(dir, "layouts"))
    os.MkdirAll(join(dir, "assets"))

    io.WriteFile(join(dir, "neyx.config.yml"), CONFIG_TPL)
    io.WriteFile(join(dir, "content/index.md"), INDEX_TPL)
    io.WriteFile(join(dir, "layouts/default.html"), LAYOUT_TPL)
    io.WriteFile(join(dir, ".gitignore"), GITIGNORE_TPL)

    write_default_favicon(dir, "favicon.ico", FAVICON_ICO_B64)
    write_default_favicon(dir, "favicon-light.png", FAVICON_LIGHT_B64)
    write_default_favicon(dir, "favicon-dark.png", FAVICON_DARK_B64)
    write_default_favicon(dir, "apple-touch-icon.png", APPLE_TOUCH_ICON_B64)
end

func run_post(args: Vector<str>):
    if args.len() < 2:
        printerrln "usage: neyx new post <title>"
        os.Exit(1)
    end

    title := args.get(1)
    site := config.Load("neyx.config.yml")
    slug := blk.Slugify(title)
    dir := site.content_dir + "/posts"
    path := dir + "/" + slug + ".md"

    if os.Exists(path):
        printerrln "neyx: '" + path + "' already exists"
        os.Exit(1)
    end

    os.MkdirAll(dir)
    today := time.FormatDate(time.Now())
    text := "---\ntitle: \"" + title + "\"\ndate: \"" + today + "\"\ndraft: false\n---\n\nWrite your post here.\n"
    io.WriteFile(path, text)
    println "Created", path
end

pub func Run(args: Vector<str>):
    if args.len() > 0 && args.get(0) == "post":
        run_post(args)
        ret
    end

    if args.len() == 0:
        printerrln "usage: neyx new <name>"
        os.Exit(1)
    end

    name := args.get(0)
    if os.Exists(name):
        printerrln "neyx: '" + name + "' already exists"
        os.Exit(1)
    end

    scaffold_into(name)

    println "Created project '" + name + "':"
    println "  " + name + "/neyx.config.yml"
    println "  " + name + "/content/index.md"
    println "  " + name + "/layouts/default.html"
    println "  " + name + "/.gitignore"
    println "  " + name + "/assets/favicon.ico"
    println ""
    println "Next steps:"
    println "  cd " + name
    println "  neyx dev"
end

pub func Init(_args: Vector<str>):
    if os.Exists("neyx.config.yml"):
        printerrln "neyx: neyx.config.yml already exists here"
        os.Exit(1)
    end

    scaffold_into("")

    println "Initialized a NeyX project in the current directory."
    println ""
    println "Next steps:"
    println "  neyx dev"
end
