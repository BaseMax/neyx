package dev

import os
import str
import conv
import flag
import net.tcp
import buildcmd "../build/builder.salam"
import config "../config/config.salam"

func watch_paths(site: config.Site): Vector<str>:
    mut parts := Vector {} as Vector<str>
    parts.push(site.content_dir)
    parts.push(site.layouts_dir)
    if os.IsDir(site.assets_dir): parts.push(site.assets_dir) end
    if os.IsDir(site.data_dir): parts.push(site.data_dir) end
    if os.IsDir(site.static_dir): parts.push(site.static_dir) end
    if site.theme != "" && os.IsDir("themes/" + site.theme): parts.push("themes/" + site.theme) end
    parts.push("neyx.config.yml")
    ret parts
end

func unix_script(watch: str, stamp: str, script_path: str, build_cmd: str, output: str, port: str): str:
    mut script := ""
    script = script + "touch " + stamp + "\n"
    script = script + "(while true; do\n"
    script = script + "  changed=$(find " + watch + " -newer " + stamp + " 2>/dev/null)\n"
    script = script + "  if [ -n \"$changed\" ]; then\n"
    script = script + "    touch " + stamp + "\n"
    script = script + "    echo \"\"\n"
    script = script + "    echo \"Change detected, rebuilding...\"\n"
    script = script + "    " + build_cmd + "\n"
    script = script + "  fi\n"
    script = script + "  sleep 1\n"
    script = script + "done) &\n"
    script = script + "watch_pid=$!\n"
    script = script + "trap \"kill $watch_pid 2>/dev/null; rm -f " + stamp + " " + script_path + "\" EXIT\n"
    script = script + "salam serve " + output + " --port=" + port + "\n"
    ret script
end

func windows_watcher_script(): str:
    mut script := ""
    script = script + "param($stampFile, $dirsArg, $cmd)\n"
    script = script + "$dirs = $dirsArg -split ';'\n"
    script = script + "while ($true) {\n"
    script = script + "  $stamp = (Get-Item $stampFile).LastWriteTime\n"
    script = script + "  $changed = Get-ChildItem -Path $dirs -Recurse -File -ErrorAction SilentlyContinue | Where-Object { $_.LastWriteTime -gt $stamp }\n"
    script = script + "  if ($changed) {\n"
    script = script + "    Get-Date | Out-File -FilePath $stampFile\n"
    script = script + "    Write-Host \"\"\n"
    script = script + "    Write-Host \"Change detected, rebuilding...\"\n"
    script = script + "    Invoke-Expression $cmd\n"
    script = script + "  }\n"
    script = script + "  Start-Sleep -Seconds 1\n"
    script = script + "}\n"
    ret script
end

func windows_script(watch_list: Vector<str>, stamp: str, script_path: str, watch_script_path: str, build_cmd: str, output: str, port: str): str:
    dirs := str.Join(watch_list, ";")
    mut script := ""
    script = script + "Get-Date | Out-File -FilePath '" + stamp + "'\n"
    script = script + "$watchArgs = @('-NoProfile', '-ExecutionPolicy', 'Bypass', '-File', '" + watch_script_path + "', '" + stamp + "', '" + dirs + "', '" + build_cmd + "')\n"
    script = script + "$watchProc = Start-Process -FilePath 'powershell' -ArgumentList $watchArgs -WindowStyle Hidden -PassThru\n"
    script = script + "try {\n"
    script = script + "  salam serve " + output + " --port=" + port + "\n"
    script = script + "} finally {\n"
    script = script + "  Stop-Process -Id $watchProc.Id -Force -ErrorAction SilentlyContinue\n"
    script = script + "  Remove-Item '" + stamp + "' -ErrorAction SilentlyContinue\n"
    script = script + "  Remove-Item '" + watch_script_path + "' -ErrorAction SilentlyContinue\n"
    script = script + "  Remove-Item '" + script_path + "' -ErrorAction SilentlyContinue\n"
    script = script + "}\n"
    ret script
end

pub func Run(args: Vector<str>):
    mut fs := flag.New("neyx dev", "Start the development server")
    flag.AddStr(fs, "port", "p", "3000", "Port to serve on")
    flag.AddBool(fs, "drafts", "", false, "Include draft content")
    flag.Parse(fs, args)

    include_drafts := flag.GetBool(fs, "drafts")

    mut build_args := Vector {} as Vector<str>
    build_args.push("--pretty")
    build_args.push("--no-images")
    if include_drafts:
        build_args.push("--drafts")
    end
    buildcmd.Run(build_args)

    site := config.Load("neyx.config.yml")
    port := flag.GetStr(fs, "port")
    port_num := conv.Atoi(port)

    probe := tcp.Dial("127.0.0.1", port_num)
    if tcp.ConnOk(probe):
        tcp.Close(probe)
        printerrln "neyx: port " + port + " is already in use."
        printerrln "  Another 'neyx dev' or 'salam serve' may still be running in the background."
        printerrln "  Stop it, or run with a different port: neyx dev --port=<port>"
        os.Exit(1)
    end

    self_args := os.Args()
    self_path := self_args.get(0)
    mut build_cmd := "\"" + self_path + "\" build --pretty --no-images"
    if include_drafts:
        build_cmd = build_cmd + " --drafts"
    end

    watch_list := watch_paths(site)
    defer watch_list.free()

    println ""
    println "Serving", site.output, "at http://localhost:" + port
    println "Watching for changes (Ctrl+C to stop)..."

    tmp := os.TempDir()
    pid := conv.FormatInt(os.Pid() as i64)

    if SALAM_OS_WINDOWS:
        stamp := tmp + "\\neyx-dev-stamp-" + pid + ".txt"
        script_path := tmp + "\\neyx-dev-" + pid + ".ps1"
        watch_script_path := tmp + "\\neyx-dev-watch-" + pid + ".ps1"
        os.WriteFile(watch_script_path, windows_watcher_script())
        script := windows_script(watch_list, stamp, script_path, watch_script_path, build_cmd, site.output, port)
        os.WriteFile(script_path, script)
        os.Run("powershell -NoProfile -ExecutionPolicy Bypass -File \"" + script_path + "\"")
    else:
        watch := str.Join(watch_list, " ")
        stamp := tmp + "/.neyx-dev-stamp-" + pid
        script_path := tmp + "/neyx-dev-" + pid + ".sh"
        script := unix_script(watch, stamp, script_path, build_cmd, site.output, port)
        os.WriteFile(script_path, script)
        os.Run("sh \"" + script_path + "\"")
    end
end
