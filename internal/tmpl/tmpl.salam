package tmpl

import os
import io
import str
import conv
import math
import collections
import encoding
import encoding.json
import encoding.value
import esc "../markdown/escape.salam"
import blk "../markdown/blocks.salam"

pub const NodeText := 0
pub const NodeVar := 1
pub const NodeRaw := 2
pub const NodeIf := 3
pub const NodeEach := 4
pub const NodeWith := 5
pub const NodeInclude := 6
pub const NodeSet := 7

pub struct FilterCall:
    pub name: str = ""
    pub args: Vector<str> = Vector {} as Vector<str>
end

pub struct Node:
    pub kind: int = NodeText
    pub text: str = ""
    pub path: str = ""
    pub loop_var: str = ""
    pub index_var: str = ""
    pub with_name: str = ""
    pub filters: Vector<FilterCall> = Vector {} as Vector<FilterCall>
    pub body: Vector<Node> = Vector {} as Vector<Node>
    pub else_body: Vector<Node> = Vector {} as Vector<Node>
end

pub struct Frame:
    pub name: str = ""
    pub val: value.Value = value.Value {}
end

func find_tag(t: str, from: int, tag_out &: str, start_out &: int, end_out &: int): bool:
    lb := str.IndexFrom(t, "{{", from)
    if lb < 0: ret false end
    rb := str.IndexFrom(t, "}}", lb + 2)
    if rb < 0: ret false end
    tag_out = str.Trim(t.substr(lb + 2, rb - lb - 2))
    start_out = lb
    end_out = rb + 2
    ret true
end

func quote_aware_split_char(s: str, sep: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut cur := str.NewBuilder()
    n := s.len()
    mut in_quote := false
    mut quote_ch := ""
    mut i := 0
    while i < n:
        c := s.substr(i, 1)
        if in_quote:
            str.BufAppend(cur, c)
            if c == quote_ch: in_quote = false end
            i += 1
            continue
        end
        if c == "\"" || c == "'":
            in_quote = true
            quote_ch = c
            str.BufAppend(cur, c)
            i += 1
            continue
        end
        if c == sep:
            out.push(str.BufStr(cur))
            str.BufReset(cur)
            i += 1
            continue
        end
        str.BufAppend(cur, c)
        i += 1
    end
    out.push(str.BufStr(cur))
    str.BufFree(cur)
    ret out
end

func tokenize_args(s: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut cur := str.NewBuilder()
    mut has_cur := false
    n := s.len()
    mut in_quote := false
    mut quote_ch := ""
    mut i := 0
    while i < n:
        c := s.substr(i, 1)
        if in_quote:
            if c == quote_ch:
                in_quote = false
            else:
                str.BufAppend(cur, c)
            end
            i += 1
            continue
        end
        if c == "\"" || c == "'":
            in_quote = true
            quote_ch = c
            has_cur = true
            i += 1
            continue
        end
        if c == " " || c == "\t":
            if has_cur:
                out.push(str.BufStr(cur))
                str.BufReset(cur)
                has_cur = false
            end
            i += 1
            continue
        end
        str.BufAppend(cur, c)
        has_cur = true
        i += 1
    end
    if has_cur:
        out.push(str.BufStr(cur))
    end
    str.BufFree(cur)
    ret out
end

func parse_pipeline(expr: str, path_out &: str, filters_out &: Vector<FilterCall>):
    segments := quote_aware_split_char(expr, "|")
    path_out = str.Trim(segments.get(0))
    mut i := 1
    while i < segments.len():
        seg := str.Trim(segments.get(i))
        toks := tokenize_args(seg)
        mut fc := FilterCall {}
        if toks.len() > 0:
            fc.name = toks.get(0)
            mut j := 1
            while j < toks.len():
                fc.args.push(toks.get(j))
                j += 1
            end
        end
        filters_out.push(fc)
        toks.free()
        i += 1
    end
    segments.free()
end

func unquote(s: str): str:
    n := s.len()
    if n >= 2 && str.StartsWith(s, "\"") && str.EndsWith(s, "\""):
        ret s.substr(1, n - 2)
    end
    if n >= 2 && str.StartsWith(s, "'") && str.EndsWith(s, "'"):
        ret s.substr(1, n - 2)
    end
    ret s
end

func parse_nodes(t: str, pos &: int, ended &: str): Vector<Node>:
    mut nodes := Vector {} as Vector<Node>
    n := t.len()
    while pos < n:
        mut tag := ""
        mut tstart := 0
        mut tend := 0
        found := find_tag(t, pos, tag, tstart, tend)

        if !found:
            mut node := Node { kind = NodeText }
            node.text = t.substr(pos, n - pos)
            nodes.push(node)
            pos = n
            ended = ""
            ret nodes
        end

        if tstart > pos:
            mut node := Node { kind = NodeText }
            node.text = t.substr(pos, tstart - pos)
            nodes.push(node)
        end

        if tag == "else":
            pos = tend
            ended = "else"
            ret nodes
        end

        if tag == "end":
            pos = tend
            ended = "end"
            ret nodes
        end

        if str.StartsWith(tag, "!"):
            pos = tend
            continue
        end

        if str.StartsWith(tag, "if "):
            cond := str.Trim(tag.substr(3, tag.len() - 3))
            pos = tend
            mut then_ended := ""
            body := parse_nodes(t, pos, then_ended)
            mut else_body := Vector {} as Vector<Node>
            if then_ended == "else":
                mut else_ended := ""
                else_body = parse_nodes(t, pos, else_ended)
            end
            mut node := Node { kind = NodeIf }
            node.path = cond
            node.body = body
            node.else_body = else_body
            nodes.push(node)
            continue
        end

        if str.StartsWith(tag, "each "):
            rest := str.Trim(tag.substr(5, tag.len() - 5))
            in_idx := str.IndexOf(rest, " in ")
            mut vars_part := rest
            mut src_path := ""
            if in_idx > 0:
                vars_part = str.Trim(rest.substr(0, in_idx))
                src_path = str.Trim(rest.substr(in_idx + 4, rest.len() - in_idx - 4))
            end
            mut index_var := ""
            mut loop_var := vars_part
            comma_idx := str.IndexOf(vars_part, ",")
            if comma_idx > 0:
                index_var = str.Trim(vars_part.substr(0, comma_idx))
                loop_var = str.Trim(vars_part.substr(comma_idx + 1, vars_part.len() - comma_idx - 1))
            end
            pos = tend
            mut body_ended := ""
            body := parse_nodes(t, pos, body_ended)
            mut node := Node { kind = NodeEach }
            node.path = src_path
            node.loop_var = loop_var
            node.index_var = index_var
            node.body = body
            nodes.push(node)
            continue
        end

        if str.StartsWith(tag, "with "):
            rest := str.Trim(tag.substr(5, tag.len() - 5))
            as_idx := str.IndexOf(rest, " as ")
            mut src_path := rest
            mut alias := "with"
            if as_idx > 0:
                src_path = str.Trim(rest.substr(0, as_idx))
                alias = str.Trim(rest.substr(as_idx + 4, rest.len() - as_idx - 4))
            end
            pos = tend
            mut then_ended := ""
            body := parse_nodes(t, pos, then_ended)
            mut else_body := Vector {} as Vector<Node>
            if then_ended == "else":
                mut else_ended := ""
                else_body = parse_nodes(t, pos, else_ended)
            end
            mut node := Node { kind = NodeWith }
            node.path = src_path
            node.with_name = alias
            node.body = body
            node.else_body = else_body
            nodes.push(node)
            continue
        end

        if str.StartsWith(tag, "set "):
            rest := str.Trim(tag.substr(4, tag.len() - 4))
            eq_idx := str.IndexOf(rest, "=")
            mut var_name := rest
            mut expr := ""
            if eq_idx > 0:
                var_name = str.Trim(rest.substr(0, eq_idx))
                expr = str.Trim(rest.substr(eq_idx + 1, rest.len() - eq_idx - 1))
            end
            mut node := Node { kind = NodeSet }
            node.with_name = var_name
            mut path := ""
            parse_pipeline(expr, path, node.filters)
            node.path = path
            nodes.push(node)
            pos = tend
            continue
        end

        if str.StartsWith(tag, "include "):
            rest := str.Trim(tag.substr(8, tag.len() - 8))
            mut node := Node { kind = NodeInclude }
            node.path = unquote(rest)
            nodes.push(node)
            pos = tend
            continue
        end

        if str.StartsWith(tag, "&"):
            expr := str.Trim(tag.substr(1, tag.len() - 1))
            mut node := Node { kind = NodeRaw }
            mut path := ""
            parse_pipeline(expr, path, node.filters)
            node.path = path
            nodes.push(node)
            pos = tend
            continue
        end

        mut node := Node { kind = NodeVar }
        mut path := ""
        parse_pipeline(tag, path, node.filters)
        node.path = path
        nodes.push(node)
        pos = tend
    end
    ended = ""
    ret nodes
end

func is_index(s: str): bool:
    if s == "": ret false end
    n := s.len()
    mut i := 0
    while i < n:
        c := s.substr(i, 1)
        if c < "0" || c > "9": ret false end
        i += 1
    end
    ret true
end

func lookup(root: value.Value, scopes: Vector<Frame>, path: str): value.Value:
    parts := str.Split(path, ".")
    defer parts.free()
    if parts.len() == 0: ret value.Value {} end
    first := parts.get(0)

    mut base := value.Value {}
    mut found := false
    mut i := scopes.len() - 1
    while i >= 0:
        f := scopes.get(i)
        if f.name == first:
            base = f.val
            found = true
            i = 0 - 1
        else:
            i -= 1
        end
    end

    mut start_idx := 1
    if !found:
        base = root
        start_idx = 0
    end

    mut cur := base
    mut j := start_idx
    while j < parts.len():
        seg := parts.get(j)
        if value.IsArray(cur):
            if !is_index(seg): ret value.Value {} end
            idx := conv.Atoi(seg)
            if idx < 0 || idx >= value.ArrayLen(cur): ret value.Value {} end
            cur = value.ArrayGet(cur, idx)
        else value.IsObject(cur):
            mut ok := false
            cur = value.ObjectGetOk(cur, seg, ok)
            if !ok: ret value.Value {} end
        else:
            ret value.Value {}
        end
        j += 1
    end
    ret cur
end

func truthy(v: value.Value): bool:
    if value.IsBool(v): ret value.AsBool(v) end
    if value.IsString(v): ret value.AsString(v) != "" end
    if value.IsInt(v): ret value.AsInt(v) != 0 end
    if value.IsFloat(v): ret value.AsFloat(v) != 0.0 end
    if value.IsArray(v): ret value.ArrayLen(v) > 0 end
    if value.IsObject(v): ret value.ObjectLen(v) > 0 end
    ret false
end

func to_str(v: value.Value): str:
    if value.IsString(v): ret value.AsString(v) end
    if value.IsBool(v):
        if value.AsBool(v): ret "true" end
        ret "false"
    end
    if value.IsInt(v): ret conv.FormatInt(value.AsInt(v)) end
    if value.IsFloat(v): ret conv.FormatFloat(value.AsFloat(v)) end
    ret ""
end

func as_number(v: value.Value): f64:
    if value.IsInt(v): ret value.AsInt(v) as f64 end
    if value.IsFloat(v): ret value.AsFloat(v) end
    ret 0.0
end

func is_numeric_literal(s: str): bool:
    if s == "": ret false end
    n := s.len()
    mut i := 0
    if s.substr(0, 1) == "-": i = 1 end
    if i >= n: ret false end
    mut dots := 0
    mut digits := 0
    while i < n:
        c := s.substr(i, 1)
        if c == ".":
            dots += 1
            if dots > 1: ret false end
        else c >= "0" && c <= "9":
            digits += 1
        else:
            ret false
        end
        i += 1
    end
    ret digits > 0
end

func parse_literal(root: value.Value, scopes: Vector<Frame>, tok: str): value.Value:
    n := tok.len()
    if n >= 2 && str.StartsWith(tok, "\"") && str.EndsWith(tok, "\""):
        ret value.ValueString(tok.substr(1, n - 2))
    end
    if n >= 2 && str.StartsWith(tok, "'") && str.EndsWith(tok, "'"):
        ret value.ValueString(tok.substr(1, n - 2))
    end
    if tok == "true": ret value.ValueBool(true) end
    if tok == "false": ret value.ValueBool(false) end
    if is_numeric_literal(tok):
        if str.Contains(tok, "."):
            ret value.ValueFloat(conv.ParseFloat(tok))
        end
        ret value.ValueInt(conv.ParseInt(tok))
    end
    ret lookup(root, scopes, tok)
end

func find_cmp_op(a: str, idx_out &: int, len_out &: int, op_out &: str): bool:
    n := a.len()
    mut in_quote := false
    mut quote_ch := ""
    mut i := 0
    while i < n:
        c := a.substr(i, 1)
        if in_quote:
            if c == quote_ch: in_quote = false end
            i += 1
            continue
        end
        if c == "\"" || c == "'":
            in_quote = true
            quote_ch = c
            i += 1
            continue
        end
        if i + 1 < n:
            two := a.substr(i, 2)
            if two == "==" || two == "!=" || two == ">=" || two == "<=":
                idx_out = i
                len_out = 2
                op_out = two
                ret true
            end
        end
        if c == ">" || c == "<":
            idx_out = i
            len_out = 1
            op_out = c
            ret true
        end
        i += 1
    end
    ret false
end

func eval_atom(root: value.Value, scopes: Vector<Frame>, atom: str): bool:
    a := str.Trim(atom)
    if a == "": ret false end
    if a == "true": ret true end
    if a == "false": ret false end
    if str.StartsWith(a, "!"):
        inner := str.Trim(a.substr(1, a.len() - 1))
        if inner == "true": ret false end
        if inner == "false": ret true end
        ret !truthy(lookup(root, scopes, inner))
    end

    mut op_idx := 0
    mut op_len := 0
    mut op := ""
    has_op := find_cmp_op(a, op_idx, op_len, op)
    if has_op:
        lhs_tok := str.Trim(a.substr(0, op_idx))
        rhs_tok := str.Trim(a.substr(op_idx + op_len, a.len() - op_idx - op_len))
        lhs := lookup(root, scopes, lhs_tok)
        rhs := parse_literal(root, scopes, rhs_tok)
        if op == "==": ret value.Equal(lhs, rhs) end
        if op == "!=": ret !value.Equal(lhs, rhs) end
        if value.IsNumber(lhs) && value.IsNumber(rhs):
            ln := as_number(lhs)
            rn := as_number(rhs)
            if op == ">": ret ln > rn end
            if op == "<": ret ln < rn end
            if op == ">=": ret ln >= rn end
            ret ln <= rn
        end
        if value.IsString(lhs) && value.IsString(rhs):
            ls := value.AsString(lhs)
            rs := value.AsString(rhs)
            if op == ">": ret ls > rs end
            if op == "<": ret ls < rs end
            if op == ">=": ret ls >= rs end
            ret ls <= rs
        end
        ret false
    end

    ret truthy(lookup(root, scopes, a))
end

func find_logical_op(a: str, op_out &: str): bool:
    n := a.len()
    mut in_quote := false
    mut quote_ch := ""
    mut i := 0
    while i < n:
        c := a.substr(i, 1)
        if in_quote:
            if c == quote_ch: in_quote = false end
            i += 1
            continue
        end
        if c == "\"" || c == "'":
            in_quote = true
            quote_ch = c
            i += 1
            continue
        end
        if i + 1 < n:
            two := a.substr(i, 2)
            if two == "&&" || two == "||":
                op_out = two
                ret true
            end
        end
        i += 1
    end
    ret false
end

func eval_cond(root: value.Value, scopes: Vector<Frame>, cond: str): bool:
    mut logical_op := ""
    has_logical := find_logical_op(cond, logical_op)
    if !has_logical:
        ret eval_atom(root, scopes, cond)
    end

    parts := str.Split(cond, logical_op)
    defer parts.free()
    if logical_op == "&&":
        mut i := 0
        while i < parts.len():
            if !eval_atom(root, scopes, parts.get(i)): ret false end
            i += 1
        end
        ret true
    end

    mut i := 0
    while i < parts.len():
        if eval_atom(root, scopes, parts.get(i)): ret true end
        i += 1
    end
    ret false
end

func filter_arg(fc: FilterCall, idx: int, def: str): str:
    if idx < fc.args.len(): ret fc.args.get(idx) end
    ret def
end

func strip_tags(s: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    n := s.len()
    mut i := 0
    mut in_tag := false
    while i < n:
        c := s.substr(i, 1)
        if c == "<":
            in_tag = true
        else c == ">":
            in_tag = false
        else:
            if !in_tag: str.BufAppend(sb, c) end
        end
        i += 1
    end
    ret str.BufStr(sb)
end

func numeric_op(v: value.Value, arg: str, op: str): value.Value:
    if value.IsInt(v) && !str.Contains(arg, "."):
        a := value.AsInt(v)
        b := conv.ParseInt(arg)
        if op == "add": ret value.ValueInt(a + b) end
        if op == "sub": ret value.ValueInt(a - b) end
        if op == "mul": ret value.ValueInt(a * b) end
        if b == 0: ret value.ValueInt(0) end
        ret value.ValueInt(a / b)
    end
    a := as_number(v)
    b := conv.ParseFloat(arg)
    if op == "add": ret value.ValueFloat(a + b) end
    if op == "sub": ret value.ValueFloat(a - b) end
    if op == "mul": ret value.ValueFloat(a * b) end
    if b == 0.0: ret value.ValueFloat(0.0) end
    ret value.ValueFloat(a / b)
end

func value_less(a: value.Value, b: value.Value): bool:
    if value.IsNumber(a) && value.IsNumber(b): ret as_number(a) < as_number(b) end
    ret to_str(a) < to_str(b)
end

func sort_values(v: value.Value): value.Value:
    if !value.IsArray(v): ret v end
    n := value.ArrayLen(v)
    mut out := value.NewValueArray()
    repeat n with i:
        value.ArrayPush(out, value.ArrayGet(v, i))
    end
    mut a := 1
    while a < n:
        mut j := a
        while j > 0 && value_less(value.ArrayGet(out, j), value.ArrayGet(out, j - 1)):
            tmp := value.ArrayGet(out, j)
            value.ArraySet(out, j, value.ArrayGet(out, j - 1))
            value.ArraySet(out, j - 1, tmp)
            j -= 1
        end
        a += 1
    end
    ret out
end

func unique_values(v: value.Value): value.Value:
    if !value.IsArray(v): ret v end
    n := value.ArrayLen(v)
    mut out := value.NewValueArray()
    mut seen := Vector {} as Vector<str>
    defer seen.free()
    mut i := 0
    while i < n:
        item := value.ArrayGet(v, i)
        key := to_str(item)
        if !collections.contains(seen, key):
            seen.push(key)
            value.ArrayPush(out, item)
        end
        i += 1
    end
    ret out
end

func apply_filter(v: value.Value, fc: FilterCall, safe_out &: bool): value.Value:
    name := fc.name

    if name == "safe":
        safe_out = true
        ret v
    end
    if name == "upper": ret value.ValueString(str.Upper(to_str(v))) end
    if name == "lower": ret value.ValueString(str.Lower(to_str(v))) end
    if name == "title": ret value.ValueString(str.Title(to_str(v))) end
    if name == "capitalize":
        s := to_str(v)
        if s.len() == 0: ret value.ValueString("") end
        ret value.ValueString(str.Upper(s.substr(0, 1)) + str.Lower(s.substr(1, s.len() - 1)))
    end
    if name == "trim": ret value.ValueString(str.Trim(to_str(v))) end
    if name == "reverse":
        if value.IsArray(v):
            len := value.ArrayLen(v)
            mut out := value.NewValueArray()
            mut i := len - 1
            while i >= 0:
                value.ArrayPush(out, value.ArrayGet(v, i))
                i -= 1
            end
            ret out
        end
        ret value.ValueString(str.Reverse(to_str(v)))
    end
    if name == "sort": ret sort_values(v) end
    if name == "unique": ret unique_values(v) end
    if name == "length":
        if value.IsArray(v): ret value.ValueInt(value.ArrayLen(v) as i64) end
        if value.IsObject(v): ret value.ValueInt(value.ObjectLen(v) as i64) end
        ret value.ValueInt(to_str(v).len() as i64)
    end
    if name == "first":
        if value.IsArray(v):
            if value.ArrayLen(v) == 0: ret value.Value {} end
            ret value.ArrayGet(v, 0)
        end
        s := to_str(v)
        if s.len() == 0: ret value.ValueString("") end
        ret value.ValueString(s.substr(0, 1))
    end
    if name == "last":
        if value.IsArray(v):
            len := value.ArrayLen(v)
            if len == 0: ret value.Value {} end
            ret value.ArrayGet(v, len - 1)
        end
        s := to_str(v)
        if s.len() == 0: ret value.ValueString("") end
        ret value.ValueString(s.substr(s.len() - 1, 1))
    end
    if name == "nth":
        idx := conv.Atoi(filter_arg(fc, 0, "0"))
        if value.IsArray(v):
            if idx < 0 || idx >= value.ArrayLen(v): ret value.Value {} end
            ret value.ArrayGet(v, idx)
        end
        ret value.Value {}
    end
    if name == "keys":
        if value.IsObject(v):
            names := value.ObjectKeys(v)
            mut out := value.NewValueArray()
            repeat names.len() with i:
                value.ArrayPush(out, value.ValueString(names.get(i)))
            end
            names.free()
            ret out
        end
        ret value.NewValueArray()
    end
    if name == "min" || name == "max":
        if value.IsArray(v):
            len := value.ArrayLen(v)
            if len == 0: ret value.Value {} end
            mut best := as_number(value.ArrayGet(v, 0))
            mut i := 1
            while i < len:
                x := as_number(value.ArrayGet(v, i))
                if name == "min":
                    if x < best: best = x end
                else:
                    if x > best: best = x end
                end
                i += 1
            end
            ret value.ValueFloat(best)
        end
        ret v
    end
    if name == "add": ret numeric_op(v, filter_arg(fc, 0, "0"), "add") end
    if name == "sub": ret numeric_op(v, filter_arg(fc, 0, "0"), "sub") end
    if name == "mul": ret numeric_op(v, filter_arg(fc, 0, "0"), "mul") end
    if name == "div": ret numeric_op(v, filter_arg(fc, 0, "1"), "div") end
    if name == "join":
        sep := filter_arg(fc, 0, ",")
        if value.IsArray(v):
            mut parts := Vector {} as Vector<str>
            repeat value.ArrayLen(v) with i:
                parts.push(to_str(value.ArrayGet(v, i)))
            end
            joined := str.Join(parts, sep)
            parts.free()
            ret value.ValueString(joined)
        end
        ret v
    end
    if name == "split":
        sep := filter_arg(fc, 0, " ")
        parts := str.Split(to_str(v), sep)
        mut out := value.NewValueArray()
        repeat parts.len() with i:
            value.ArrayPush(out, value.ValueString(parts.get(i)))
        end
        parts.free()
        ret out
    end
    if name == "truncate":
        limit := conv.Atoi(filter_arg(fc, 0, "0"))
        s := to_str(v)
        if s.len() <= limit: ret value.ValueString(s) end
        ret value.ValueString(s.substr(0, limit) + "...")
    end
    if name == "truncatewords":
        limit := conv.Atoi(filter_arg(fc, 0, "0"))
        words := str.Fields(to_str(v))
        if words.len() <= limit:
            joined_all := str.Join(words, " ")
            words.free()
            ret value.ValueString(joined_all)
        end
        mut parts := Vector {} as Vector<str>
        mut i := 0
        while i < limit:
            parts.push(words.get(i))
            i += 1
        end
        joined := str.Join(parts, " ")
        parts.free()
        words.free()
        ret value.ValueString(joined + "...")
    end
    if name == "replace":
        old := filter_arg(fc, 0, "")
        nw := filter_arg(fc, 1, "")
        ret value.ValueString(str.Replace(to_str(v), old, nw))
    end
    if name == "default":
        if truthy(v): ret v end
        ret value.ValueString(filter_arg(fc, 0, ""))
    end
    if name == "slugify": ret value.ValueString(blk.Slugify(to_str(v))) end
    if name == "striptags": ret value.ValueString(strip_tags(to_str(v))) end
    if name == "urlencode": ret value.ValueString(encoding.URLEncode(to_str(v))) end
    if name == "json": ret value.ValueString(json.EncodeDefault(v)) end
    if name == "round": ret value.ValueInt(math.Round(as_number(v)) as i64) end
    if name == "abs":
        if value.IsInt(v): ret value.ValueInt(math.AbsI64(value.AsInt(v))) end
        ret value.ValueFloat(math.Abs(as_number(v)))
    end
    if name == "pluralize":
        singular := filter_arg(fc, 0, "")
        plural := filter_arg(fc, 1, singular + "s")
        count := as_number(v) as i64
        if count == 1: ret value.ValueString(singular) end
        ret value.ValueString(plural)
    end

    ret v
end

func apply_filters(v: value.Value, filters: Vector<FilterCall>, safe_out &: bool): value.Value:
    mut cur := v
    repeat filters.len() with i:
        cur = apply_filter(cur, filters.get(i), safe_out)
    end
    ret cur
end

func render_nodes(nodes: Vector<Node>, root: value.Value, scopes &: Vector<Frame>, out &: str.StringBuilder, layouts_dir: str, depth: int):
    mut set_count := 0
    repeat nodes.len() with i:
        node := nodes.get(i)
        if node.kind == NodeText:
            str.BufAppend(out, node.text)
        else node.kind == NodeVar:
            v := parse_literal(root, scopes, node.path)
            mut safe := false
            v2 := apply_filters(v, node.filters, safe)
            s := to_str(v2)
            if safe:
                str.BufAppend(out, s)
            else:
                str.BufAppend(out, esc.EscapeHtml(s))
            end
        else node.kind == NodeRaw:
            v := parse_literal(root, scopes, node.path)
            mut safe := false
            v2 := apply_filters(v, node.filters, safe)
            str.BufAppend(out, to_str(v2))
        else node.kind == NodeIf:
            cond := eval_cond(root, scopes, node.path)
            if cond:
                render_nodes(node.body, root, scopes, out, layouts_dir, depth)
            else:
                render_nodes(node.else_body, root, scopes, out, layouts_dir, depth)
            end
        else node.kind == NodeEach:
            v := lookup(root, scopes, node.path)
            if value.IsArray(v):
                len := value.ArrayLen(v)
                mut item_frame := Frame { name = node.loop_var }
                mut idx_frame := Frame { name = node.index_var }
                mut loop_frame := Frame { name = "loop" }
                has_idx := node.index_var != ""
                repeat len with idx:
                    item_frame.val = value.ArrayGet(v, idx)
                    scopes.push(item_frame)
                    if has_idx:
                        idx_frame.val = value.ValueInt(idx as i64)
                        scopes.push(idx_frame)
                    end

                    mut loop_obj := value.NewValueObject()
                    value.ObjectSet(loop_obj, "index", value.ValueInt(idx as i64))
                    value.ObjectSet(loop_obj, "index1", value.ValueInt((idx + 1) as i64))
                    value.ObjectSet(loop_obj, "first", value.ValueBool(idx == 0))
                    value.ObjectSet(loop_obj, "last", value.ValueBool(idx == len - 1))
                    value.ObjectSet(loop_obj, "length", value.ValueInt(len as i64))
                    loop_frame.val = loop_obj
                    scopes.push(loop_frame)

                    render_nodes(node.body, root, scopes, out, layouts_dir, depth)

                    _d1 := scopes.pop()
                    if has_idx:
                        _d2 := scopes.pop()
                    end
                    _d0 := scopes.pop()
                end
            end
        else node.kind == NodeWith:
            v := lookup(root, scopes, node.path)
            if truthy(v):
                mut frame := Frame { name = node.with_name }
                frame.val = v
                scopes.push(frame)
                render_nodes(node.body, root, scopes, out, layouts_dir, depth)
                _d := scopes.pop()
            else:
                render_nodes(node.else_body, root, scopes, out, layouts_dir, depth)
            end
        else node.kind == NodeSet:
            v := parse_literal(root, scopes, node.path)
            mut safe := false
            v2 := apply_filters(v, node.filters, safe)
            mut frame := Frame { name = node.with_name }
            frame.val = v2
            scopes.push(frame)
            set_count += 1
        else node.kind == NodeInclude:
            if depth < 32 && layouts_dir != "":
                full_path := layouts_dir + "/" + node.path
                if os.Exists(full_path):
                    partial_text := io.ReadFile(full_path)
                    partial_nodes := Parse(partial_text)
                    render_nodes(partial_nodes, root, scopes, out, layouts_dir, depth + 1)
                end
            end
        end
    end
    repeat set_count with _:
        _d := scopes.pop()
    end
end

pub func Parse(t: str): Vector<Node>:
    mut pos := 0
    mut ended := ""
    ret parse_nodes(t, pos, ended)
end

pub func Render(t: str, root: value.Value, layouts_dir: str): str:
    nodes := Parse(t)
    mut scopes := Vector {} as Vector<Frame>
    defer scopes.free()
    mut out := str.NewBuilder()
    defer str.BufFree(out)
    render_nodes(nodes, root, scopes, out, layouts_dir, 0)
    ret str.BufStr(out)
end
