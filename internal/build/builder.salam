package build

import config "../config/config.salam"
import markdown "../markdown/markdown.salam"

pub func Run(_args: Vector<str>):
    site := config.Load("neyx.config.yml")
    println "building", site.title, "->", site.output

    mut toc := ""
    mut html := ""
    markdown.ToHtml("# Hello\n\nThis is **bold** and *em* and `code`.\n\n- one\n- two\n\n> a quote\n", toc, html)
    println html
end
