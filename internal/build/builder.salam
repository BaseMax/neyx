package build

import os
import io
import str
import flag
import conv
import time
import encoding.value
import config "../config/config.salam"
import content "../content/loader.salam"
import p "../content/page.salam"
import tmpl "../tmpl/tmpl.salam"
import sitemap "../sitemap/sitemap.salam"
import feed "../feed/feed.salam"
import taxonomy "../taxonomy/taxonomy.salam"
import data "../data/data.salam"
import minify "../minify/minify.salam"
import imagepipe "../imagepipe/imagepipe.salam"
import search "../search/search.salam"
import encoding.json

const DEFAULT_LAYOUT := "<!doctype html>\n<html lang=\"{{ lang }}\" dir=\"{{ dir }}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{ title }}</title>\n{{ if description }}<meta name=\"description\" content=\"{{ description }}\">{{ end }}\n{{ if noindex }}<meta name=\"robots\" content=\"noindex\">{{ end }}\n<link rel=\"canonical\" href=\"{{ site.url }}{{ url }}\">\n<meta property=\"og:title\" content=\"{{ title }}\">\n{{ if description }}<meta property=\"og:description\" content=\"{{ description }}\">{{ end }}\n<meta property=\"og:url\" content=\"{{ site.url }}{{ url }}\">\n<meta property=\"og:type\" content=\"website\">\n<meta name=\"twitter:card\" content=\"summary\">\n</head>\n<body>\n{{ & content }}\n</body>\n</html>\n"

func text_dir(lang: str): str:
    if lang == "fa" || lang == "ar" || lang == "he" || lang == "ur": ret "rtl" end
    ret "ltr"
end

func effective_lang(site: config.Site, page: p.Page): str:
    if page.lang != "": ret page.lang end
    ret site.language
end

func theme_layout_path(site: config.Site, name: str): str:
    if site.theme == "": ret "" end
    ret "themes/" + site.theme + "/layouts/" + name + ".html"
end

func layout_for(site: config.Site, name: str): str:
    path := site.layouts_dir + "/" + name + ".html"
    if os.Exists(path): ret io.ReadFile(path) end

    theme_path := theme_layout_path(site, name)
    if theme_path != "" && os.Exists(theme_path): ret io.ReadFile(theme_path) end

    if name != "default": ret layout_for(site, "default") end
    ret DEFAULT_LAYOUT
end

func posts_only(pages: Vector<p.Page>): Vector<p.Page>:
    mut out := Vector {} as Vector<p.Page>
    repeat pages.len() with i:
        page := pages.get(i)
        if p.Date(page) != "":
            out.push(page)
        end
    end

    n := out.len()
    repeat n with i:
        mut j := i
        while j > 0 && str.Compare(p.Date(out.get(j - 1)), p.Date(out.get(j))) < 0:
            a := out.get(j - 1)
            b := out.get(j)
            out.set(j - 1, b)
            out.set(j, a)
            j -= 1
        end
    end
    ret out
end

func filter_by_lang(items: Vector<p.Page>, lang: str): Vector<p.Page>:
    mut out := Vector {} as Vector<p.Page>
    repeat items.len() with i:
        item := items.get(i)
        if item.lang == lang:
            out.push(item)
        end
    end
    ret out
end

func page_summary(page: p.Page): value.Value:
    mut v := value.ValueClone(page.front)
    value.ObjectSet(v, "url", value.ValueString(page.route))
    ret v
end

func pages_value(pages: Vector<p.Page>): value.Value:
    mut arr := value.NewValueArray()
    repeat pages.len() with i:
        value.ArrayPush(arr, page_summary(pages.get(i)))
    end
    ret arr
end

func render_page(site: config.Site, page: p.Page, pages: Vector<p.Page>, posts: Vector<p.Page>, data_val: value.Value): str:
    lang := effective_lang(site, page)
    scoped_pages := filter_by_lang(pages, page.lang)
    defer scoped_pages.free()
    scoped_posts := filter_by_lang(posts, page.lang)
    defer scoped_posts.free()

    mut root := value.ValueClone(page.front)
    value.ObjectSet(root, "content", value.ValueString(page.content_html))
    value.ObjectSet(root, "url", value.ValueString(page.route))
    value.ObjectSet(root, "site", site.data)
    value.ObjectSet(root, "pages", pages_value(scoped_pages))
    value.ObjectSet(root, "posts", pages_value(scoped_posts))
    value.ObjectSet(root, "data", data_val)
    value.ObjectSet(root, "lang", value.ValueString(lang))
    value.ObjectSet(root, "dir", value.ValueString(text_dir(lang)))
    tpl_text := layout_for(site, page.tmpl)
    ret tmpl.Render(tpl_text, root)
end

func write_page(site: config.Site, page: p.Page, pages: Vector<p.Page>, posts: Vector<p.Page>, data_val: value.Value, do_minify: bool, quiet: bool):
    mut html := render_page(site, page, pages, posts, data_val)
    if do_minify: html = minify.Html(html) end
    dir := site.output + page.route
    os.MkdirAll(dir)
    io.WriteFile(dir + "index.html", html)
    if !quiet: println "  wrote", dir + "index.html" end
end

func ceil_div(a: int, b: int): int:
    if b <= 0: ret 1 end
    ret (a + b - 1) / b
end

func posts_slice_value(posts: Vector<p.Page>, offset: int, count: int): value.Value:
    mut arr := value.NewValueArray()
    end_i := offset + count
    mut i := offset
    while i < posts.len() && i < end_i:
        value.ArrayPush(arr, page_summary(posts.get(i)))
        i += 1
    end
    ret arr
end

func page_num_route(base_route: str, page_num: int): str:
    if page_num <= 1: ret base_route end
    ret base_route + "page/" + conv.FormatInt(page_num as i64) + "/"
end

func write_paginated(site: config.Site, page: p.Page, pages: Vector<p.Page>, posts: Vector<p.Page>, data_val: value.Value, do_minify: bool, quiet: bool):
    scoped_pages := filter_by_lang(pages, page.lang)
    defer scoped_pages.free()
    scoped_posts := filter_by_lang(posts, page.lang)
    defer scoped_posts.free()
    all_val := pages_value(scoped_pages)

    size := site.pagination_size
    mut total_pages := ceil_div(scoped_posts.len(), size)
    if total_pages < 1: total_pages = 1 end

    repeat total_pages with idx:
        page_num := idx + 1
        slice_val := posts_slice_value(scoped_posts, idx * size, size)
        route := page_num_route(page.route, page_num)

        lang := effective_lang(site, page)
        mut root := value.ValueClone(page.front)
        value.ObjectSet(root, "content", value.ValueString(page.content_html))
        value.ObjectSet(root, "url", value.ValueString(route))
        value.ObjectSet(root, "site", site.data)
        value.ObjectSet(root, "pages", all_val)
        value.ObjectSet(root, "posts", slice_val)
        value.ObjectSet(root, "data", data_val)
        value.ObjectSet(root, "lang", value.ValueString(lang))
        value.ObjectSet(root, "dir", value.ValueString(text_dir(lang)))

        mut pg := value.NewValueObject()
        value.ObjectSet(pg, "page", value.ValueInt(page_num as i64))
        value.ObjectSet(pg, "total_pages", value.ValueInt(total_pages as i64))
        value.ObjectSet(pg, "has_prev", value.ValueBool(page_num > 1))
        value.ObjectSet(pg, "has_next", value.ValueBool(page_num < total_pages))
        value.ObjectSet(pg, "prev_url", value.ValueString(page_num_route(page.route, page_num - 1)))
        value.ObjectSet(pg, "next_url", value.ValueString(page_num_route(page.route, page_num + 1)))
        value.ObjectSet(root, "pagination", pg)

        tpl_text := layout_for(site, page.tmpl)
        mut html := tmpl.Render(tpl_text, root)
        if do_minify: html = minify.Html(html) end

        dir := site.output + route
        os.MkdirAll(dir)
        io.WriteFile(dir + "index.html", html)
        if !quiet: println "  wrote", dir + "index.html" end
    end
end

func is_draft(page: p.Page): bool:
    ret p.BoolField(page.front, "draft", false)
end

func drop_drafts(pages: Vector<p.Page>): Vector<p.Page>:
    mut out := Vector {} as Vector<p.Page>
    repeat pages.len() with i:
        page := pages.get(i)
        if !is_draft(page):
            out.push(page)
        end
    end
    ret out
end

func search_index_value(pages: Vector<p.Page>): value.Value:
    mut arr := value.NewValueArray()
    repeat pages.len() with i:
        page := pages.get(i)
        mut entry := value.NewValueObject()
        value.ObjectSet(entry, "title", value.ValueString(p.Title(page)))
        value.ObjectSet(entry, "description", value.ValueString(p.Description(page)))
        value.ObjectSet(entry, "url", value.ValueString(page.route))
        value.ArrayPush(arr, entry)
    end
    ret arr
end

func write_robots(site: config.Site, quiet: bool):
    mut text := "User-agent: *\nAllow: /\n"
    if site.url != "":
        text = text + "\nSitemap: " + site.url + "/sitemap.xml\n"
    end
    io.WriteFile(site.output + "/robots.txt", text)
    if !quiet: println "  wrote", site.output + "/robots.txt" end
end

pub func Run(args: Vector<str>):
    start_ns := time.MonoNanos()

    mut fs := flag.New("neyx build", "Build the site for production")
    flag.AddBool(fs, "drafts", "", false, "Include draft content")
    flag.AddBool(fs, "pretty", "", false, "Skip HTML/XML minification")
    flag.AddBool(fs, "json", "", false, "Print a JSON build summary instead of human output")
    flag.AddBool(fs, "no-images", "", false, "Skip responsive image generation")
    flag.Parse(fs, args)
    include_drafts := flag.GetBool(fs, "drafts")
    do_minify := !flag.GetBool(fs, "pretty")
    quiet := flag.GetBool(fs, "json")
    skip_images := flag.GetBool(fs, "no-images")

    site := config.Load("neyx.config.yml")

    if site.hook_before_build != "":
        if !quiet: println "  running before_build hook" end
        os.Run(site.hook_before_build)
    end

    if !os.IsDir(site.content_dir):
        printerrln "neyx: no", site.content_dir, "directory - nothing to build"
        os.Exit(1)
    end

    mut pages := content.LoadAll(site.content_dir, site.languages)
    if !include_drafts:
        pages = drop_drafts(pages)
    end
    defer pages.free()
    posts := posts_only(pages)
    defer posts.free()

    all_val := pages_value(pages)
    posts_val := pages_value(posts)
    data_val := data.LoadAll(site.data_dir)

    os.RemoveAll(site.output)
    os.MkdirAll(site.output)

    repeat pages.len() with i:
        write_page(site, pages.get(i), pages, posts, data_val, do_minify, quiet)
    end

    repeat pages.len() with i:
        page := pages.get(i)
        if p.BoolField(page.front, "paginate", false):
            write_paginated(site, page, pages, posts, data_val, do_minify, quiet)
        end
    end

    if site.theme != "":
        theme_assets := "themes/" + site.theme + "/assets"
        if os.IsDir(theme_assets):
            os.CopyTree(theme_assets, site.output + "/assets")
        end
    end

    if os.IsDir(site.assets_dir):
        os.CopyTree(site.assets_dir, site.output + "/assets")
    end

    if site.optimize_images && !skip_images:
        image_count := imagepipe.Process(site.output + "/assets")
        if !quiet && image_count > 0: println "  generated", image_count, "optimized image(s)" end
    end

    taxonomy.Build(site, pages, do_minify, quiet)

    mut sitemap_xml := sitemap.Build(site, pages)
    if do_minify: sitemap_xml = minify.Xml(sitemap_xml) end
    io.WriteFile(site.output + "/sitemap.xml", sitemap_xml)
    if !quiet: println "  wrote", site.output + "/sitemap.xml" end

    mut feed_xml := feed.Build(site, posts)
    if do_minify: feed_xml = minify.Xml(feed_xml) end
    io.WriteFile(site.output + "/feed.xml", feed_xml)
    if !quiet: println "  wrote", site.output + "/feed.xml" end

    write_robots(site, quiet)

    os.MkdirAll(site.output + "/api")
    io.WriteFile(site.output + "/api/pages.json", json.EncodeDefault(all_val))
    if !quiet: println "  wrote", site.output + "/api/pages.json" end

    io.WriteFile(site.output + "/api/posts.json", json.EncodeDefault(posts_val))
    if !quiet: println "  wrote", site.output + "/api/posts.json" end

    search_val := search_index_value(pages)
    io.WriteFile(site.output + "/search-index.json", json.EncodeDefault(search_val))
    if !quiet: println "  wrote", site.output + "/search-index.json" end

    os.MkdirAll(site.output + "/assets")
    io.WriteFile(site.output + "/assets/neyx-search.js", search.Script())
    if !quiet: println "  wrote", site.output + "/assets/neyx-search.js" end

    if os.IsDir(site.static_dir):
        os.CopyTree(site.static_dir, site.output)
    end

    if site.hook_after_build != "":
        if !quiet: println "  running after_build hook" end
        os.Run(site.hook_after_build)
    end

    elapsed_ms := time.SinceMs(start_ns)
    if quiet:
        println "{\"pages\": " + conv.FormatInt(pages.len() as i64) + ", \"output\": \"" + site.output + "\", \"minified\": " + (do_minify ? "true" : "false") + ", \"drafts\": " + (include_drafts ? "true" : "false") + ", \"elapsed_ms\": " + conv.FormatFloatPrec(elapsed_ms, 2) + "}"
    else:
        println ""
        println "Built", pages.len(), "page(s) into", site.output, "in", conv.FormatFloatPrec(elapsed_ms, 2), "ms"
    end
end
