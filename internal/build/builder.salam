package build

import os
import io
import str
import flag
import conv
import time
import encoding.value
import config "../config/config.salam"
import content "../content/loader.salam"
import p "../content/page.salam"
import tmpl "../tmpl/tmpl.salam"
import sitemap "../sitemap/sitemap.salam"
import feed "../feed/feed.salam"
import taxonomy "../taxonomy/taxonomy.salam"
import data "../data/data.salam"
import minify "../minify/minify.salam"
import encoding.json

const DEFAULT_LAYOUT := "<!doctype html>\n<html lang=\"{{ site.language }}\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>{{ title }}</title>\n{{ if description }}<meta name=\"description\" content=\"{{ description }}\">{{ end }}\n<link rel=\"canonical\" href=\"{{ site.url }}{{ url }}\">\n<meta property=\"og:title\" content=\"{{ title }}\">\n{{ if description }}<meta property=\"og:description\" content=\"{{ description }}\">{{ end }}\n<meta property=\"og:url\" content=\"{{ site.url }}{{ url }}\">\n<meta property=\"og:type\" content=\"website\">\n<meta name=\"twitter:card\" content=\"summary\">\n</head>\n<body>\n{{ & content }}\n</body>\n</html>\n"

func layout_for(site: config.Site, name: str): str:
    path := site.layouts_dir + "/" + name + ".html"
    if os.Exists(path): ret io.ReadFile(path) end
    if name != "default": ret layout_for(site, "default") end
    ret DEFAULT_LAYOUT
end

func posts_only(pages: Vector<p.Page>): Vector<p.Page>:
    mut out := Vector {} as Vector<p.Page>
    repeat pages.len() with i:
        page := pages.get(i)
        if p.Date(page) != "":
            out.push(page)
        end
    end

    n := out.len()
    repeat n with i:
        mut j := i
        while j > 0 && str.Compare(p.Date(out.get(j - 1)), p.Date(out.get(j))) < 0:
            a := out.get(j - 1)
            b := out.get(j)
            out.set(j - 1, b)
            out.set(j, a)
            j -= 1
        end
    end
    ret out
end

func page_summary(page: p.Page): value.Value:
    mut v := value.ValueClone(page.front)
    value.ObjectSet(v, "url", value.ValueString(page.route))
    ret v
end

func pages_value(pages: Vector<p.Page>): value.Value:
    mut arr := value.NewValueArray()
    repeat pages.len() with i:
        value.ArrayPush(arr, page_summary(pages.get(i)))
    end
    ret arr
end

func render_page(site: config.Site, page: p.Page, all_val: value.Value, posts_val: value.Value, data_val: value.Value): str:
    mut root := value.ValueClone(page.front)
    value.ObjectSet(root, "content", value.ValueString(page.content_html))
    value.ObjectSet(root, "url", value.ValueString(page.route))
    value.ObjectSet(root, "site", site.data)
    value.ObjectSet(root, "pages", all_val)
    value.ObjectSet(root, "posts", posts_val)
    value.ObjectSet(root, "data", data_val)
    tpl_text := layout_for(site, page.tmpl)
    ret tmpl.Render(tpl_text, root)
end

func write_page(site: config.Site, page: p.Page, all_val: value.Value, posts_val: value.Value, data_val: value.Value, do_minify: bool):
    mut html := render_page(site, page, all_val, posts_val, data_val)
    if do_minify: html = minify.Html(html) end
    dir := site.output + page.route
    os.MkdirAll(dir)
    io.WriteFile(dir + "index.html", html)
    println "  wrote", dir + "index.html"
end

func ceil_div(a: int, b: int): int:
    if b <= 0: ret 1 end
    ret (a + b - 1) / b
end

func posts_slice_value(posts: Vector<p.Page>, offset: int, count: int): value.Value:
    mut arr := value.NewValueArray()
    end_i := offset + count
    mut i := offset
    while i < posts.len() && i < end_i:
        value.ArrayPush(arr, page_summary(posts.get(i)))
        i += 1
    end
    ret arr
end

func page_num_route(base_route: str, page_num: int): str:
    if page_num <= 1: ret base_route end
    ret base_route + "page/" + conv.FormatInt(page_num as i64) + "/"
end

func write_paginated(site: config.Site, page: p.Page, posts: Vector<p.Page>, all_val: value.Value, data_val: value.Value, do_minify: bool):
    size := site.pagination_size
    mut total_pages := ceil_div(posts.len(), size)
    if total_pages < 1: total_pages = 1 end

    repeat total_pages with idx:
        page_num := idx + 1
        slice_val := posts_slice_value(posts, idx * size, size)
        route := page_num_route(page.route, page_num)

        mut root := value.ValueClone(page.front)
        value.ObjectSet(root, "content", value.ValueString(page.content_html))
        value.ObjectSet(root, "url", value.ValueString(route))
        value.ObjectSet(root, "site", site.data)
        value.ObjectSet(root, "pages", all_val)
        value.ObjectSet(root, "posts", slice_val)
        value.ObjectSet(root, "data", data_val)

        mut pg := value.NewValueObject()
        value.ObjectSet(pg, "page", value.ValueInt(page_num as i64))
        value.ObjectSet(pg, "total_pages", value.ValueInt(total_pages as i64))
        value.ObjectSet(pg, "has_prev", value.ValueBool(page_num > 1))
        value.ObjectSet(pg, "has_next", value.ValueBool(page_num < total_pages))
        value.ObjectSet(pg, "prev_url", value.ValueString(page_num_route(page.route, page_num - 1)))
        value.ObjectSet(pg, "next_url", value.ValueString(page_num_route(page.route, page_num + 1)))
        value.ObjectSet(root, "pagination", pg)

        tpl_text := layout_for(site, page.tmpl)
        mut html := tmpl.Render(tpl_text, root)
        if do_minify: html = minify.Html(html) end

        dir := site.output + route
        os.MkdirAll(dir)
        io.WriteFile(dir + "index.html", html)
        println "  wrote", dir + "index.html"
    end
end

func is_draft(page: p.Page): bool:
    ret p.BoolField(page.front, "draft", false)
end

func drop_drafts(pages: Vector<p.Page>): Vector<p.Page>:
    mut out := Vector {} as Vector<p.Page>
    repeat pages.len() with i:
        page := pages.get(i)
        if !is_draft(page):
            out.push(page)
        end
    end
    ret out
end

func search_index_value(pages: Vector<p.Page>): value.Value:
    mut arr := value.NewValueArray()
    repeat pages.len() with i:
        page := pages.get(i)
        mut entry := value.NewValueObject()
        value.ObjectSet(entry, "title", value.ValueString(p.Title(page)))
        value.ObjectSet(entry, "description", value.ValueString(p.Description(page)))
        value.ObjectSet(entry, "url", value.ValueString(page.route))
        value.ArrayPush(arr, entry)
    end
    ret arr
end

func write_robots(site: config.Site):
    mut text := "User-agent: *\nAllow: /\n"
    if site.url != "":
        text = text + "\nSitemap: " + site.url + "/sitemap.xml\n"
    end
    io.WriteFile(site.output + "/robots.txt", text)
    println "  wrote", site.output + "/robots.txt"
end

pub func Run(args: Vector<str>):
    start_ns := time.MonoNanos()

    mut fs := flag.New("neyx build", "Build the site for production")
    flag.AddBool(fs, "drafts", "", false, "Include draft content")
    flag.AddBool(fs, "pretty", "", false, "Skip HTML/XML minification")
    flag.Parse(fs, args)
    include_drafts := flag.GetBool(fs, "drafts")
    do_minify := !flag.GetBool(fs, "pretty")

    site := config.Load("neyx.config.yml")

    if !os.IsDir(site.content_dir):
        printerrln "neyx: no", site.content_dir, "directory - nothing to build"
        os.Exit(1)
    end

    mut pages := content.LoadAll(site.content_dir)
    if !include_drafts:
        pages = drop_drafts(pages)
    end
    defer pages.free()
    posts := posts_only(pages)
    defer posts.free()

    all_val := pages_value(pages)
    posts_val := pages_value(posts)
    data_val := data.LoadAll(site.data_dir)

    os.RemoveAll(site.output)
    os.MkdirAll(site.output)

    repeat pages.len() with i:
        write_page(site, pages.get(i), all_val, posts_val, data_val, do_minify)
    end

    repeat pages.len() with i:
        page := pages.get(i)
        if p.BoolField(page.front, "paginate", false):
            write_paginated(site, page, posts, all_val, data_val, do_minify)
        end
    end

    if os.IsDir(site.assets_dir):
        os.CopyTree(site.assets_dir, site.output + "/assets")
    end

    taxonomy.Build(site, pages, do_minify)

    mut sitemap_xml := sitemap.Build(site, pages)
    if do_minify: sitemap_xml = minify.Xml(sitemap_xml) end
    io.WriteFile(site.output + "/sitemap.xml", sitemap_xml)
    println "  wrote", site.output + "/sitemap.xml"

    mut feed_xml := feed.Build(site, posts)
    if do_minify: feed_xml = minify.Xml(feed_xml) end
    io.WriteFile(site.output + "/feed.xml", feed_xml)
    println "  wrote", site.output + "/feed.xml"

    write_robots(site)

    os.MkdirAll(site.output + "/api")
    io.WriteFile(site.output + "/api/pages.json", json.EncodeDefault(all_val))
    println "  wrote", site.output + "/api/pages.json"

    io.WriteFile(site.output + "/api/posts.json", json.EncodeDefault(posts_val))
    println "  wrote", site.output + "/api/posts.json"

    search_val := search_index_value(pages)
    io.WriteFile(site.output + "/search-index.json", json.EncodeDefault(search_val))
    println "  wrote", site.output + "/search-index.json"

    if os.IsDir(site.static_dir):
        os.CopyTree(site.static_dir, site.output)
    end

    elapsed_ms := time.SinceMs(start_ns)
    println ""
    println "Built", pages.len(), "page(s) into", site.output, "in", conv.FormatFloatPrec(elapsed_ms, 2), "ms"
end
